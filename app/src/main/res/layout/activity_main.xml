<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="48dp">

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Screen Recorder TV"
        android:textColor="@color/text_primary"
        android:textSize="34sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Ready to record"
        android:textColor="@color/text_secondary"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/timerText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="00:00:00"
        android:textColor="@color/text_primary"
        android:textSize="24sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:orientation="horizontal">

        <Spinner
            android:id="@+id/qualitySpinner"
            android:layout_width="180dp"
            android:layout_height="64dp"
            android:focusable="true" />

        <Spinner
            android:id="@+id/fpsSpinner"
            android:layout_width="160dp"
            android:layout_height="64dp"
            android:layout_marginStart="20dp"
            android:focusable="true" />
    </LinearLayout>

    <Button
        android:id="@+id/recordButton"
        android:layout_width="320dp"
        android:layout_height="72dp"
        android:layout_marginTop="32dp"
        android:focusable="true"
        android:text="@string/start_recording"
        android:textSize="20sp" />

    <TextView
        android:layout_width="720dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="center"
        android:text="Recordings are saved in Movies/ScreenRecorderTV. DRM-protected or secure content may appear black."
        android:textColor="@color/text_secondary"
        android:textSize="16sp" />
</LinearLayout>
